# Runbook-search MCP server — wraps the INTERNAL SemanticMemoryStore, so
# (unlike the other two MCP images) it installs the full app requirements:
# it imports app/, embeds queries locally (sentence-transformers) and reads
# pgvector over asyncpg. That heavier image is the honest cost of exposing
# an internal capability as its own service.
FROM python:3.12-slim

WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app app
COPY mcp_servers/__init__.py mcp_servers/__init__.py
COPY mcp_servers/runbook_server mcp_servers/runbook_server

EXPOSE 8103
HEALTHCHECK --interval=5s --timeout=5s --retries=10 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8103/health')"

CMD ["uvicorn", "mcp_servers.runbook_server.server:app", "--host", "0.0.0.0", "--port", "8103"]

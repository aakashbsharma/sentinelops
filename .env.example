# --- Database ---
# Must use the asyncpg driver — the app validates this prefix at startup.
DATABASE_URL=postgresql+asyncpg://sentinelops:sentinelops@localhost:5432/sentinelops

# --- Redis (Celery broker/result backend, later stages) ---
REDIS_URL=redis://localhost:6379/0

# --- Runtime ---
ENVIRONMENT=dev            # dev | staging | prod
LOG_LEVEL=INFO

# --- LLM provider (optional until agent stages) ---
ANTHROPIC_API_KEY=

# --- Agent guardrails (enforced from Stage 2 onward) ---
MAX_AGENT_ITERATIONS=8
AGENT_TOKEN_BUDGET=50000

# --- Orchestrator guardrails (Stage 5) ---
# Re-runs allowed per stage when an agent reports needs_more_data.
MAX_RETRY_ATTEMPTS=2
# Incident-level cap on TOTAL agent invocations; exceeding it force-escalates.
MAX_ORCHESTRATION_ROUNDS=6

# --- MCP tool servers (Stage 6) ---
# false = use in-process mock tools (fast, hermetic — what the unit suite uses).
USE_MCP_TOOLS=true
LOGS_METRICS_MCP_URL=http://localhost:8101/mcp
INFRA_MCP_URL=http://localhost:8102/mcp
RUNBOOK_MCP_URL=http://localhost:8103/mcp
MCP_CONNECT_TIMEOUT_S=10
# Simulated-world state for the logs/metrics MCP server (server-side env var,
# NOT a tool parameter — agents must not choose their own evidence):
# connection_pool_exhaustion | memory_leak | bad_deploy | retry_storm | (unset = healthy)
#SIMULATED_SCENARIO=connection_pool_exhaustion

# The single production execution switch: false = all remediations dry-run.
EXECUTOR_ALLOW_REAL_EXECUTION=false
